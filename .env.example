# development 或 production。production 下若缺少 ENCRYPTION_KEY 会直接启动失败
APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=1323

# sqlite 或 postgres
DB_DRIVER=sqlite
DB_PATH=app.db

# PostgreSQL
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=emailbox
# DB_SSLMODE=disable

SESSION_EXPIRE_HOUR=24
# 生产环境（HTTPS）必须设置为 true，否则会话 Cookie 可能被明文传输
COOKIE_SECURE=false

# 允许跨域的前端来源，逗号分隔（不能为空，也不接受 *）
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# 部署在 Nginx / Traefik / 云负载均衡等反向代理后面时设为 true，
# 否则限流会把所有用户当成同一个 IP，一个人触发限流会波及全部用户
TRUST_PROXY=false

# 邮箱凭据（密码、refresh_token、代理地址）的加密密钥，32 字节的 base64 或 hex。
# 用 `make gen-key` 生成。留空时开发模式明文存储并告警，生产模式启动失败。
# 密钥一旦丢失，已存的凭据无法恢复；轮换密钥需要先解密再重新加密。
# ENCRYPTION_KEY=

# 注册模式：open（任何人可注册）/ closed（仅管理员创建）
REGISTRATION_MODE=open

# 启动时把该邮箱对应的用户提升为平台管理员；用户不存在时不做任何事，等他注册后下次启动生效
# BOOTSTRAP_ADMIN_USERNAME=admin

# 新注册租户默认套餐的 code
DEFAULT_PLAN_CODE=free

# 批量任务：每个任务内部的并发数、账号之间的间隔（毫秒）、任务事件的保留天数。
# 并发调大要同时把间隔调大，否则容易触发服务商风控导致账号被封。
JOB_WORKERS=8
JOB_ACCOUNT_DELAY_MS=0
JOB_EVENT_RETENTION_DAYS=7
