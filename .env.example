# development 或 production。production 下若缺少 ENCRYPTION_KEY 会直接启动失败
APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=1323

# sqlite 或 postgres
DB_DRIVER=sqlite
DB_PATH=app.db

# PostgreSQL
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=emailbox
# DB_SSLMODE=disable

SESSION_EXPIRE_HOUR=24
# 生产环境（HTTPS）必须设置为 true，否则会话 Cookie 可能被明文传输
COOKIE_SECURE=false

# 允许跨域的前端来源，逗号分隔（不能为空，也不接受 *）
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# 部署在 Nginx / Traefik / 云负载均衡等反向代理后面时设为 true，
# 否则限流会把所有用户当成同一个 IP，一个人触发限流会波及全部用户
TRUST_PROXY=false

# 邮箱凭据（密码、refresh_token、代理地址）的加密密钥，32 字节的 base64 或 hex。
# 留空时开发模式明文存储并告警，生产模式启动失败。
# 密钥一旦丢失，已存的凭据无法恢复；轮换密钥需要先解密再重新加密。
#
# 下面是**示例值，仅供本地跑起来用**。任何真实部署都必须换成自己的：
#   make gen-key
# 用示例值等于没加密——这个值在仓库里公开可见，谁都能解开你库里的凭据。
ENCRYPTION_KEY=ZXhhbXBsZS1rZXktZG8tbm90LXVzZS1pbi1wcm9kISE=

# 注册模式：open（任何人可注册）/ closed（仅管理员创建）
REGISTRATION_MODE=open

# 平台管理员。启动时把该用户名对应的用户提升为管理员（认用户名不认邮箱，
# 邮箱是可选字段）；该用户还不存在且填了密码时，直接把他建出来。
#
# 用户已存在时**不会**改他的密码——配置文件不该能悄悄接管一个已有账号。
# 建号成功后请立刻登录改密码，并把 BOOTSTRAP_ADMIN_PASSWORD 从环境里删掉：
# 下面这个密码写在仓库的示例文件里，等于公开的。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123..

# 新注册租户默认套餐的 code
DEFAULT_PLAN_CODE=free

# 批量任务：每个任务内部的并发数、账号之间的间隔（毫秒）、任务事件的保留天数。
# 并发调大要同时把间隔调大，否则容易触发服务商风控导致账号被封。
JOB_WORKERS=8
JOB_ACCOUNT_DELAY_MS=0
JOB_EVENT_RETENTION_DAYS=7

# Microsoft OAuth 重新授权。默认 client_id 与回调地址沿用参考项目；若应用后台没有
# 配置本项目的 HTTPS 回调，用户可在 Token 页粘贴浏览器最终跳转地址完成授权。
MICROSOFT_OAUTH_ENABLED=true
MICROSOFT_OAUTH_CLIENT_ID=9e5f94bc-e8a4-4e73-b8be-63364c29d753
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8080
MICROSOFT_OAUTH_RETURN_URL=http://localhost:5173/mail/tokens
# 机密客户端才需要；公共客户端保持留空
# MICROSOFT_OAUTH_CLIENT_SECRET=
